# Tiny LLM & Autonomous Agent Environment Configuration
# Copy this file to .env and adjust as necessary for your hardware.

# OpenBLAS / MKL CPU Thread Clamping (Prevents Windows memory allocation retries)
OPENBLAS_NUM_THREADS=4
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
KMP_DUPLICATE_LIB_OK=TRUE

# Default Execution Device: auto, cpu, cuda, or mps
COMPUTE_DEVICE=auto

# Default Checkpoint for Chat and Evaluation
DEFAULT_CHECKPOINT=checkpoints/modern_production_v2_best.pt

# Local Ollama Backend (Optional Teacher / Pretrained Model)
OLLAMA_HOST=http://localhost:11434

# SQLite Memory Database
MEMORY_DB_PATH=tiny_llm_memory.db
